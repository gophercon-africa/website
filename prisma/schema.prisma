generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int?
  author    User?   @relation(fields: [authorId], references: [id])
}

model Talk {
  id                         String   @id @default(cuid())
  fullName                   String
  email                      String
  phone                      String
  company                    String
  title                      String
  bio                        String
  talkTitle                  String
  talkDescription            String
  talkCategory               String   @default("")
  talkDuration               String
  talkLevel                  String
  previousSpeakingExperience String
  additionalNotes            String
  eventYear                  String
  IsAccepted                 Boolean
  IsPendingReview            Boolean
  // Authoritative selection status: pending | shortlisted | waitlisted |
  // accepted | rejected. The booleans above are kept in sync (see
  // src/lib/talkStatus.ts); PATCH /api/admin/submissions/[id] is the only
  // sanctioned write path.
  status                     String   @default("pending")
  decisionNotes              String?
  // Set by the local send script when the decision email actually goes out;
  // read-only in the app (not writable via PATCH).
  notifiedAt                 DateTime?
  // Set when the speaker asks for more feedback on their decision.
  followUpRequestedAt        DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  reviews                    Review[]
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  role      String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([tokenHash])
}

model Review {
  id            String   @id @default(cuid())
  talkId        String
  reviewerEmail String
  rating        Float?
  notes         String
  skipped       Boolean  @default(false)
  skipReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  talk          Talk     @relation(fields: [talkId], references: [id])

  @@unique([talkId, reviewerEmail])
}

model AuthorizedUser {
  id         String   @id @default(cuid())
  email      String   @unique
  isAdmin    Boolean  @default(false)
  isReviewer Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
